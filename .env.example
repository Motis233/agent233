# .env.example —— 配置模板（复制为 .env 并填入真实密钥）
# 使用: 复制本文件为 .env，替换各值。.env 已被 .gitignore 排除，
#       密钥只留在本地，不会提交到仓库。

# LLM API 密钥（必填）
#   DeepSeek: https://platform.deepseek.com 申请（密钥以 sk- 开头）
#   智谱GLM: https://open.bigmodel.cn 申请（密钥形如 id.secret，glm-4-flash 有免费额度）
LLM_API_KEY=你的密钥

# LLM API 地址与模型名：留空即可，程序会按密钥自动识别服务商。
# 想强制指定时再取消下面的注释：
# LLM_BASE_URL=https://api.deepseek.com          # DeepSeek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # 智谱GLM
# LLM_MODEL=glm-4-flash

# Semantic Scholar API密钥（可选，申请后去掉行首#并填入）
# 免费申请: https://www.semanticscholar.org/product/api#form
# 有密钥限流额度1次/秒独享；不填则匿名模式（可用但易429）
# S2_API_KEY=你的密钥
